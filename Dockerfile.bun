# Bun runtime image — the runtime half of the framework/runtime experiment.
#
# One variable against the shipped Dockerfile: the runtime. Same source, same
# Express 5 app, same `pg`/`pg-copy-streams` drivers, same dependency versions
# (bun.lock was migrated from package-lock.json, so the transitive tree is the
# one the Node image installs). Nothing under src/ differs between the two.
#
# There is no compile stage. Bun executes TypeScript directly, so the image runs
# src/index.ts rather than dist/src/index.js. Type checking has not been dropped
# — it moved out of the image into the `npm run typecheck` gate, which still
# runs on Node with the same tsconfig.
FROM oven/bun:1.3.14-slim AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts

FROM oven/bun:1.3.14-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock tsconfig.json ./
# src/ is the runnable artifact here, not just the source of one. It also has to
# be present for migrate.ts, which reads src/db/migrations relative to cwd.
COPY src ./src
RUN chown -R bun:bun /app
USER bun
EXPOSE 8080
CMD ["bun", "run", "src/index.ts"]
