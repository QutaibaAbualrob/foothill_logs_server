# Scratch and working directory
temp/

# Local planning notes
plan/internal/

# Local reference material — must never ship in this repository
# (details: plan/internal/SANITIZATION.md)
analysis/reference/
analysis/evidence/
analysis/archive/

# Build output and dependencies
node_modules/
dist/
coverage/

# Local environment and benchmark artifacts
.env
*.log
bench/raw/
.hermes/

# Measurement write-ups and their CSV index are tracked under bench/results/,
# but raw harness output and CPU profiles are not: profiles carry the service's
# full call tree, and the volume does not belong in a public tree. Those live in
# the private analysis repo only — see plan/internal/SANITIZATION.md §7.
bench/results/**/raw/
bench/results/**/profiles/
*.cpuprofile
*.cpuprofile.gz
# Submission URLs for graded runs are the owner's, not repository content.
# Already-tracked link files from earlier runs are unaffected by this rule.
docs/run*_results/*link*.txt
