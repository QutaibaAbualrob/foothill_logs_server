# Every variable below has a working default. `docker compose up` with no .env
# and no arguments starts the complete service; this file documents the knobs,
# it is not required to run anything.

# --- Service ---
PORT=8080
DATABASE_URL=postgresql://logger:logger@localhost:5432/logs
BODY_LIMIT=4mb

# --- Durability ---
# off: the ingest transaction commits without waiting for a WAL flush. A 200
#      still means committed and queryable, but a window of acknowledged writes
#      can be lost if the PostgreSQL host dies uncleanly.
# on:  strictly crash-durable acknowledgement.
SYNC_COMMIT=off

# --- Retention ---
RETENTION_DAYS=30
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_ROWS=5000

# --- Ingestion batching (group commit) ---
BATCH_TARGET_ROWS=2000
BATCH_MAX_ROWS=5000
BATCH_TARGET_BYTES=2097152
BATCH_DELAY_MS=5

# --- Backpressure: exceeding either cap returns 503 + Retry-After ---
QUEUE_MAX_ROWS=50000
QUEUE_MAX_BYTES=33554432

# --- Connection pools ---
WRITE_POOL_SIZE=2
QUERY_POOL_SIZE=8
DB_CONNECT_TIMEOUT_MS=2000
QUERY_STATEMENT_TIMEOUT_MS=10000

# --- Read path ---
# Comma-separated attribute keys that get a partial, ordered index so that
# filtering on them returns rows in cursor order from one index scan. Empty
# ships no attribute indexes at all.
HOT_ATTRIBUTE_KEYS=trace_id
# Signs the opaque pagination cursor. Generated randomly per start if unset,
# which invalidates cursors across a restart.
CURSOR_SECRET=

# --- Shutdown ---
SHUTDOWN_TIMEOUT_MS=15000
